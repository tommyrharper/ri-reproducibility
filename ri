#!/usr/bin/env python3
"""Thin CLI dispatcher for the R2D2 and WSClean failure-mode searches."""

import argparse
import os
import shlex
import subprocess
import sys

REPO_ROOT = os.path.dirname(os.path.abspath(__file__))

IMAGES = ("wsclean", "r2d2", "meqtrees", "polychord")

# The images a search needs built before it can start.
SEARCH_IMAGES = {
    "wsclean": ("wsclean", "meqtrees", "polychord"),
    "r2d2": ("r2d2", "meqtrees", "polychord"),
}

SEARCH_SCRIPT = {
    "wsclean": "scripts/run-nested-sampling.sh",
    "r2d2": "scripts/run-nested-sampling-r2d2.sh",
}

# Search flags, as (destination, environment variable). Documented in
# docs/nested-sampling.md; defaults live in defaults.toml.
SEARCH_ENV = (
    ("nlive", "NS_NLIVE"),
    ("num_repeats", "NS_NUM_REPEATS"),
    ("max_ndead", "NS_MAX_NDEAD"),
    ("seed", "NS_SEED"),
    ("metric", "NS_METRIC"),
    ("mpi_procs", "NS_MPI_PROCS"),
    ("mgain", "NS_WSCLEAN_MGAIN"),
    ("synchronous", "NS_SYNCHRONOUS"),
    ("keep_measurement_sets", "NS_KEEP_MEASUREMENT_SETS"),
    ("retries", "NS_RETRIES"),
    ("stall_timeout", "NS_STALL_TIMEOUT"),
    ("omp_threads", "R2D2_OMP_THREADS"),
    ("output_dir", "OUTPUT_DIR"),
)


def env_from(args, pairs):
    """Environment overrides for the flags that were actually given.

    A flag left unset contributes nothing, so an environment variable the
    caller exported by hand survives, and defaults.toml supplies the rest.
    """
    return {
        # bool renders as "1"/"0", not "True"/"False": these become shell
        # environment variables, and the scripts test them the shell way.
        var: ("1" if getattr(args, dest) else "0") if isinstance(getattr(args, dest), bool)
        else str(getattr(args, dest))
        for dest, var in pairs
        if getattr(args, dest) is not None
    }


def uv(script, *args):
    return ["uv", "run", script, *args]


# --- command handlers: each returns (env overrides, commands to run) ---------


def do_build(args):
    env = {"WSCLEAN_TARGET_CPU": "native"} if args.native else {}
    return env, [["scripts/build.sh", args.target]]


def do_smoke(args):
    if args.target == "ms-to-mat":
        env = {"MS_PATH": args.ms_path} if args.ms_path else {}
        return env, [["scripts/check-ms-to-r2d2-mat.sh"]]
    targets = ("wsclean", "r2d2") if args.target == "all" else (args.target,)
    return {}, [[f"scripts/smoke-test-{t}.sh"] for t in targets]


def do_self_check(args):
    return {}, [["scripts/self-check.sh", args.target]]


def do_shell(args):
    return {}, [["scripts/shell.sh", args.image]]


def do_search(args):
    env = env_from(args, SEARCH_ENV)
    if args.native:
        # The search builds its images first, and build.sh reads this, so
        # without it here a search would rebuild the portable WSClean over any
        # native one `./ri build wsclean --native` had left under the tag.
        env["WSCLEAN_TARGET_CPU"] = "native"
    if args.enable_param:
        env["NS_ENABLE_PARAMS"] = ",".join(args.enable_param)
    if args.disable_param:
        env["NS_DISABLE_PARAMS"] = ",".join(args.disable_param)
    commands = []
    if not args.no_build:
        commands += [["scripts/build.sh", i] for i in SEARCH_IMAGES[args.imager]]
    commands.append([SEARCH_SCRIPT[args.imager]])
    return env, commands


def do_params(args):
    env = {}
    if args.enable_param:
        env["NS_ENABLE_PARAMS"] = ",".join(args.enable_param)
    if args.disable_param:
        env["NS_DISABLE_PARAMS"] = ",".join(args.disable_param)
    return env, [uv("scripts/list-parameter-space.py")]


def do_runs(args):
    flags = ["--incomplete"] if args.incomplete else []
    flags += ["--json"] if args.json else []
    return {}, [uv("scripts/nested-sampling-runs.py", *flags)]


def do_health(args):
    # A run and --all both travel: asking for both is a mistake, and the script
    # says so rather than quietly reporting on something else.
    flags = [args.run] if args.run else []
    flags += ["--all"] if args.all else []
    flags += ["--stale-seconds", str(args.stale_seconds)] if args.stale_seconds else []
    flags += ["--json"] if args.json else []
    flags += ["--monitor"] if args.monitor else []
    flags += ["--interval", str(args.interval)] if args.interval else []
    return {}, [uv("scripts/nested-sampling-health.py", *flags)]


def do_tui(args):
    # `go -C tui` rather than a go.mod at the repository root: the TUI is the
    # only Go in here, and `go run` caches its build, so a second start is
    # instant. It shells back into this script for everything it shows.
    return {}, [["go", "-C", "tui", "run", "."]]


def do_resume(args):
    # The build is the resume script's own, because only run.env knows which
    # images this run needs - unlike ./ri search, where the imager is a flag.
    env = {"NS_NO_BUILD": "1"} if args.no_build else {}
    return env, [["scripts/resume-nested-sampling-run.sh", args.run]]


def do_report(args):
    env = env_from(args, (("last", "LAST"), ("run", "RUN")))
    if args.force:
        env["FORCE"] = "1"
    if args.upgrade:
        env["UPGRADE"] = "1"
    return env, [["scripts/generate-report.sh"]]


def do_serve(args):
    return env_from(args, (("port", "REPORT_PORT"), ("bind", "REPORT_BIND"))), [
        ["scripts/serve-report.sh"]
    ]


def do_profile(args):
    return {}, [uv("scripts/profile-nested-sampling-run.py", args.run,
                   *(["--json"] if args.json else []),
                   *(["--phases"] if args.phases else []),
                   *(["--over-time"] if args.over_time else []),
                   *(["--top", str(args.top)] if args.top else []),
                   *(["--buckets", str(args.buckets)] if args.buckets else []))]


def do_bench(args):
    return {}, [uv("scripts/bench.py")]


def do_bench_run(args):
    # Builds first, exactly as a search does: the images bake the code, so
    # without it the benchmark times whatever was baked last.
    return {}, [["scripts/build.sh", i] for i in SEARCH_IMAGES[args.imager]] + [
        uv("scripts/bench.py", "run", args.imager, "--preset", args.preset,
           "--repeat", str(args.repeat))]


def do_bench_record(args):
    return {}, [uv("scripts/bench.py", "record", args.run)]


def do_merge(args):
    out = ["--out", args.out] if args.out else []
    return {}, [uv("scripts/merge-nested-sampling-runs.py", *args.runs, *out)]


def do_plot_fits(args):
    return {}, [["scripts/plot-fits.sh", *args.files]]


def do_plot_likelihood(args):
    return {}, [uv("scripts/plot-merged-likelihood-compare.py")]


def do_plot_gui(args):
    return {}, [uv("scripts/anesthetic-gui.py", *([args.run] if args.run else []))]


def do_fetch_checkpoints(args):
    return {}, [["scripts/fetch-r2d2-checkpoints.sh", args.realisation]]


def do_record(args):
    command = ["scripts/record-environment.sh", "--tool", args.tool, "--image", args.image]
    if args.config:
        command += ["--config", args.config]
    if args.command:
        command += ["--", *args.command]
    return {}, [command]


def do_clean(args):
    return {}, [["scripts/clean.sh"]]


def do_disk_usage(args):
    return {}, [["docker", "system", "df", "-v"]]


# --- argument parsing --------------------------------------------------------


def build_parser():
    # --dry-run is accepted before or after the subcommand. SUPPRESS is what
    # makes the second form work: without it argparse would copy the
    # subparser's own `False` default back over a `-n` given up front.
    dry_run = argparse.ArgumentParser(add_help=False)
    dry_run.add_argument(
        "-n", "--dry-run", action="store_true", default=argparse.SUPPRESS,
        help="print the environment and commands instead of running them",
    )

    parser = argparse.ArgumentParser(
        prog="./ri",
        description=(
            "Search the observing-parameter space of the R2D2-RI and WSClean "
            "imagers with nested sampling (PolyChord) to find where they fail."
        ),
        epilog=(
            "Typical session:\n"
            "  ./ri build                  # the four Docker images (slow, once)\n"
            "  ./ri smoke                  # can the imagers actually image?\n"
            "  ./ri search wsclean         # run a search\n"
            "  ./ri report                 # one HTML page per run\n"
            "\n"
            "Defaults come from defaults.toml; an exported environment variable\n"
            "overrides those, and a flag here overrides both. --dry-run prints\n"
            "what would be run without running it.\n"
            "\n"
            "Details: docs/cheatsheet.md, docs/nested-sampling.md."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "-n", "--dry-run", action="store_true", default=False,
        help="print the environment and commands instead of running them",
    )
    # No dest: the `record` subcommand has its own `command` positional.
    subs = parser.add_subparsers(metavar="<command>", required=True)

    def add(name, handler, help_text, **kwargs):
        description = kwargs.pop("description", help_text)
        sub = subs.add_parser(
            name, help=help_text, description=description, parents=[dry_run],
            # Prose is wrapped to the terminal; anything already laid out by
            # hand (the examples above, the search command below) is not.
            formatter_class=(
                argparse.RawDescriptionHelpFormatter if "\n" in description
                else argparse.HelpFormatter
            ),
            **kwargs
        )
        if handler is not None:
            sub.set_defaults(handler=handler)
        return sub

    # Images
    build = add("build", do_build, "build the Docker images",
                description="Build the Docker images (docker build, so re-running "
                            "just hits the layer cache).")
    build.add_argument("target", nargs="?", default="all", choices=("all", *IMAGES),
                       help="which image to build (default: all)")
    build.add_argument("--native", action="store_true",
                       help="WSClean tuned for this exact CPU (WSCLEAN_TARGET_CPU=native) "
                            "rather than the default AVX2 baseline; a little faster and "
                            "SIGILLs anywhere else. Reuses the same image tag, so the "
                            "next build without it puts the default one back - pass "
                            "--native to ./ri search too")

    self_check = add("self-check", do_self_check, "run the checks that need the images",
        description="Runs the host-side checks, then each module's own "
                    "--self-check inside the image it runs in - the ones that "
                    "need a live meqserver, a TDL compile, numpy or casacore, "
                    "and so cannot run in CI. The working tree is what runs, so "
                    "no rebuild is needed to check a change - but a run executes "
                    "the copy baked into the image, so rebuild before starting "
                    "one. All but the self-heal check start no search; that one "
                    "runs two ~45 second throwaway WSClean searches, kills one and "
                    "freezes a rank of the other, and checks both recover on "
                    "their own.")
    self_check.add_argument("target", nargs="?", default="all",
        choices=("all", "simulate", "r2d2-serve", "zygote", "wsclean", "r2d2",
                 "report", "self-heal"),
        help="which set of checks to run (default: all)")

    smoke = add("smoke", do_smoke, "check the imagers actually image",
                description="Cheap end-to-end checks to run after a rebuild, before "
                            "starting a search that calls an imager thousands of times.")
    smoke.add_argument("target", nargs="?", default="all",
                       choices=("all", "wsclean", "r2d2", "ms-to-mat"),
                       help="all (both imagers, the default), wsclean, r2d2, or "
                            "ms-to-mat for the MS -> R2D2 .mat bridge")
    smoke.add_argument("--ms-path", help="ms-to-mat only: convert this MS instead of "
                                         "simulating one (MS_PATH)")

    shell = add("shell", do_shell, "open a shell inside an image",
                description="Interactive bash in one of the built images, with this "
                            "repo's usual mounts.")
    shell.add_argument("image", choices=IMAGES, help="which image to enter")

    # Searches
    search = add(
        "search", do_search, "run a nested-sampling search",
        description=(
            "Run PolyChord over the VLA.A observing-parameter space, scoring each\n"
            "sample by how badly the imager reconstructs a known 1 Jy point source.\n"
            "Output: results/nested-sampling/<imager>-vlaa-<UTC>/\n"
            "\n"
            "Every flag below maps to the environment variable in brackets, so\n"
            "  ./ri search wsclean --nlive 8\n"
            "  NS_NLIVE=8 ./ri search wsclean\n"
            "are the same run. Unset flags fall through to the environment and\n"
            "then to defaults.toml."
        ),
    )
    search.add_argument("imager", choices=("wsclean", "r2d2"),
                        help="which imager to search")
    search.add_argument("--nlive", type=int, help="PolyChord live points [NS_NLIVE]")
    search.add_argument("--num-repeats", type=int,
                        help="exploration per replacement live point [NS_NUM_REPEATS]")
    search.add_argument("--max-ndead", type=int,
                        help="dead-point budget, terminates the run [NS_MAX_NDEAD]")
    search.add_argument("--seed", type=int, help="PolyChord seed, random per run [NS_SEED]")
    search.add_argument("--metric",
                        help="objective to maximise: badness, a bare metric name such "
                             "as total_rms_jy or sigma_res, or an arithmetic expression "
                             "over them. A leading minus needs the = form, "
                             "--metric=-snr, to search the worst corner [NS_METRIC]")
    search.add_argument("--mpi-procs", type=int,
                        help="MPI ranks; 1 is serial, for debugging [NS_MPI_PROCS]")
    search.add_argument("--mgain", type=float,
                        help="WSClean major-cycle gain, the largest throughput lever "
                             "left: it sets how many of an evaluation's ~15 gridding "
                             "and degridding passes are paid for. 0.9 is ~20%% more "
                             "evaluations per second than the 0.8 default, and moves "
                             "the default total_rms_jy objective by 1e-7 (median) but "
                             "not peak_flux_abs_error_jy or sigma_res "
                             "[NS_WSCLEAN_MGAIN], see docs/nested-sampling-clean-loop.md")
    search.add_argument("--synchronous", action=argparse.BooleanOptionalAction,
                        help="make every rank wait for the slowest one each sampling "
                             "round. Off by default: it costs ~30%% of the wall clock "
                             "here and buys nothing this search needs "
                             "[NS_SYNCHRONOUS], see docs/nested-sampling-throughput.md")
    search.add_argument("--keep-measurement-sets", action=argparse.BooleanOptionalAction,
                        help="keep every intermediate artefact of a scored evaluation - "
                             "its sim.ms and WSClean's dirty, residual, model and psf "
                             "images - instead of deleting them once it is scored. Off by "
                             "default: nothing reads any of them afterwards, and disk is "
                             "what caps a run's size - they took an evaluation "
                             "directory from 0.10MB to 1.44MB "
                             "(docs/nested-sampling-disk-footprint.md). The sim.ms it keeps "
                             "is missing six subtables the MSv2 specification calls "
                             "required, so CASA will not open it "
                             "[NS_KEEP_MEASUREMENT_SETS], see docs/nested-sampling-ms-open.md")
    search.add_argument("--omp-threads", type=int,
                        help="per-rank R2D2 OpenMP/BLAS threads [R2D2_OMP_THREADS]")
    search.add_argument("--retries", type=int, metavar="N",
                        help="times a search that died after scoring evaluations "
                             "restarts itself from its checkpoint, counting only "
                             "failures that come straight back; 0 disables "
                             "[NS_RETRIES]")
    search.add_argument("--stall-timeout", type=int, metavar="SECONDS",
                        help="seconds without a finished evaluation before a search is "
                             "killed as hung, so --retries can restart it from its "
                             "checkpoint; 0 disables [NS_STALL_TIMEOUT]")
    search.add_argument(
        "--output-dir",
        help="run directory, which must be inside the repository - the containers see nothing else [OUTPUT_DIR]",
    )
    search.add_argument("--enable-param", action="append", metavar="NAME",
                        help="search this parameter_space dimension even if defaults.toml "
                             "has it disabled; repeatable [NS_ENABLE_PARAMS]")
    search.add_argument("--disable-param", action="append", metavar="NAME",
                        help="pin this parameter_space dimension at its default/min instead "
                             "of searching it; repeatable, and --enable-param wins if a name "
                             "is given to both [NS_DISABLE_PARAMS]. ./ri params lists names "
                             "and current state")
    search.add_argument("--native", action="store_true",
                        help="build WSClean for this exact CPU (WSCLEAN_TARGET_CPU=native) "
                             "rather than the default AVX2 baseline; the binary then runs "
                             "nowhere else, see docs/nested-sampling-throughput.md")
    search.add_argument("--no-build", action="store_true",
                        help="skip the image builds this search would do first")

    params = add(
        "params", do_params, "list the parameter space and what is searched",
        description=(
            "One line per [[parameter_space]] entry in defaults.toml: its box,\n"
            "whether it is currently searched, and what it is pinned at when it is\n"
            "not.\n"
            "\n"
            "--enable-param / --disable-param preview a search's toggle state\n"
            "without running anything - the same NS_ENABLE_PARAMS / NS_DISABLE_PARAMS\n"
            "./ri search itself sets."
        ),
    )
    params.add_argument("--enable-param", action="append", metavar="NAME",
                        help="show this dimension as searched, regardless of defaults.toml")
    params.add_argument("--disable-param", action="append", metavar="NAME",
                        help="show this dimension as pinned, regardless of defaults.toml")

    runs = add(
        "runs", do_runs, "list runs and which ones stopped early",
        description=(
            "One line per run under results/nested-sampling/, with whether it\n"
            "finished. A run writes summary.json only once PolyChord returns, so\n"
            "a run without a whole one stopped early - and the HTML report,\n"
            "which globs for summary.json, does not show it at all.\n"
            "\n"
            "A run that is still going has no summary.json either, so it is\n"
            "told apart from a stopped one by its processes and shown as\n"
            "running - it is offered to ./ri health, never to ./ri resume,\n"
            "which would start a second job over its own checkpoint.\n"
            "\n"
            "Anything unfinished is listed again at the end with the ./ri resume\n"
            "line that continues it."
        ),
    )
    runs.add_argument("--incomplete", action="store_true",
                      help="only the runs that stopped before finishing")
    runs.add_argument("--json", action="store_true", help="raw JSON instead of a table")

    health = add(
        "health", do_health, "is a run progressing, and is the progress worth anything",
        description=(
            "The question ./ri runs cannot answer: a run that has not finished\n"
            "might be working, stalled, or long dead, and one that is working\n"
            "might be scoring nothing but its own failures.\n"
            "\n"
            "Reports progress and rate, how far through the search is and\n"
            "roughly how long is left, what a restart would have to redo\n"
            "from behind the last checkpoint, whether the ranks are still\n"
            "there, what an evaluation costs the imager and how much of\n"
            "the run's hardware that cost is keeping busy now and over its\n"
            "whole life, the memory and cores the run is holding, how much\n"
            "of it the host has pushed out to swap and whether anything is\n"
            "waiting on those pages, against what the host has left and what\n"
            "the host as a whole is loaded to, what one evaluation peaks at\n"
            "and what that costs across every rank, how fast it is filling\n"
            "the disk and how long that leaves, how much running time went to\n"
            "stalls, how many evaluations scored FAILURE_OBJECTIVE - which\n"
            "PolyChord maximizes, so a broken imager looks like a spectacular\n"
            "discovery - how many self-healed restarts a live run has left\n"
            "before the next crash leaves it waiting for a ./ri resume, and\n"
            "any sidecar container left holding memory by a run that is gone.\n"
            "\n"
            "Reads files, runs one ps and one docker ps, and samples CPU\n"
            "for a second when a run is live, so it costs a busy\n"
            "host nothing. Exits 1 when something needs attention, and\n"
            "says so on the run's headline as a warning count - coloured\n"
            "on a terminal, and never when piped or under NO_COLOR."
        ),
    )
    health.add_argument("run", nargs="?", metavar="RUN",
                        help="run directory, or the name this report prints - "
                             "including a run another checkout started, while "
                             "it is still running (default: every run "
                             "still running anywhere on this host, whichever "
                             "checkout started it, else this checkout's "
                             "newest run)")
    health.add_argument("--all", action="store_true",
                        help="every run on disk under this checkout")
    health.add_argument("--stale-seconds", type=float, metavar="SECONDS",
                        help="a live run silent for this long is stalled (default: 600)")
    health.add_argument("--json", action="store_true", help="raw JSON instead of a report")
    health.add_argument("--monitor", action="store_true",
                        help="redraw in place every --interval instead of "
                             "printing once and exiting (Ctrl-C to stop)")
    health.add_argument("--interval", type=float, metavar="SECONDS",
                        help="seconds between redraws under --monitor (default: 5)")

    add(
        "tui", do_tui, "watch runs, and start one, from a terminal UI",
        description=(
            "A terminal front end over the commands above: the run table is\n"
            "./ri runs, selecting a run shows ./ri health for it and re-runs\n"
            "that every 5 seconds, b shows ./ri bench, and the form starts\n"
            "./ri search.\n"
            "\n"
            "A search started here runs detached, so quitting the interface -\n"
            "or closing the terminal - leaves it going. It joins the table as\n"
            "`starting` straight away, before the images it builds are built.\n"
            "Needs Go installed; nothing else here does.\n"
            "\n"
            "Keys are listed along the bottom of each screen."
        ),
    )

    resume = add(
        "resume", do_resume, "continue a run that stopped early",
        description=(
            "Continue an interrupted run in place, keeping every evaluation it\n"
            "already finished. The run directory records the settings it was\n"
            "started with, so no flags are needed and none can be misremembered.\n"
            "\n"
            "./ri runs lists what there is to resume. A run that is still\n"
            "going is refused: a second job over its checkpoint and FIFO\n"
            "directories would corrupt both.\n"
            "\n"
            "The images the run needs are built first, exactly as ./ri search\n"
            "does - a run executes the code baked into them, so without it a\n"
            "resume silently continues on whatever was baked last time. Free\n"
            "when nothing changed; --no-build skips it."
        ),
    )
    resume.add_argument("run", metavar="RUN",
                        help="run directory, or its name under results/nested-sampling/")
    resume.add_argument("--no-build", action="store_true",
                        help="skip the image builds this resume would do first, so the "
                             "run continues on the code already baked into them")

    # Results
    report = add("report", do_report, "build the HTML run report",
                 description="Write reports/nested-sampling-report/: one page per run "
                             "plus index.html. Up-to-date pages are skipped and the "
                             "index is always rebuilt.")
    report.add_argument("--last", type=int, metavar="N",
                        help="only consider the newest N runs [LAST]")
    report.add_argument("--run", metavar="DIR",
                        help="rebuild just this run's page [RUN]")
    report.add_argument("--force", action="store_true",
                        help="rebuild every page in scope [FORCE=1]")
    report.add_argument("--upgrade", action="store_true",
                        help="rebuild pages written by an older report version "
                             "[UPGRADE=1]")

    serve = add(
        "serve", do_serve, "read the HTML report from another machine",
        description=(
            "Serve reports/nested-sampling-report/ over HTTP. Meant for the usual\n"
            "case where the search runs on a headless remote host and the browser\n"
            "is somewhere else.\n"
            "\n"
            "The server binds to loopback and prints the `ssh -L` line that\n"
            "tunnels it to your own machine, so nothing here is exposed and no\n"
            "port is opened. Runs in the foreground; Ctrl-C stops it."
        ),
    )
    serve.add_argument("--port", type=int, help="port to listen on [REPORT_PORT]")
    serve.add_argument("--bind", metavar="ADDRESS",
                       help="address to bind; 0.0.0.0 skips the tunnel and serves the "
                            "report unauthenticated to the network [REPORT_BIND]")

    profile = add("profile", do_profile, "per-stage timing for one run",
                  description="Break a finished run down by stage. Field meanings: "
                              "docs/nested-sampling-profiling.md.")
    profile.add_argument("run", metavar="RUN", help="run directory or summary.json")
    profile.add_argument("--json", action="store_true", help="raw JSON instead of a table")
    profile.add_argument("--phases", action="store_true",
                         help="break the wsclean binary down by phase, from every evaluation's "
                              "own -log-time timeline, see docs/nested-sampling-phase-profile.md")
    profile.add_argument("--over-time", action="store_true",
                         help="evaluations/second against wall clock, beside the visibility count "
                              "that sets it, see docs/nested-sampling-cost-model.md")
    profile.add_argument("--top", type=int, help="with --phases: phases to print, largest first")
    profile.add_argument("--buckets", type=int, help="with --over-time: wall-clock buckets to print")

    bench = add(
        "bench", do_bench, "throughput per commit, to catch a regression",
        description=(
            "The table in benchmarks.jsonl: evaluations/second and the per-stage\n"
            "cost behind it, one column per commit, newest first.\n"
            "\n"
            "Rows are grouped by machine, imager and settings, and each cell is a\n"
            "median with robust standard error of its repeats - so it narrows as\n"
            "repeats at one commit accumulate, and a change is only starred once\n"
            "it is bigger than the noise it has to beat.\n"
            "\n"
            "Every search that finishes adds a row. `./ri bench run` adds the\n"
            "controlled one, at the pinned settings in defaults.toml that make\n"
            "commits comparable. Details: docs/nested-sampling-benchmarks.md."
        ),
    )
    bench_subs = bench.add_subparsers(metavar="<what>")

    bench_run = bench_subs.add_parser(
        "run", parents=[dry_run], help="run the controlled search and record it",
        description="Build the images, run the search a preset pins the settings "
                    "of, and add its row. Commit first: a row carries the "
                    "commit it was measured at, and one measured on a dirty "
                    "tree is marked with a trailing +.",
    )
    bench_run.add_argument("imager", choices=("wsclean", "r2d2"),
                           help="which imager to measure")
    bench_run.add_argument("--preset", default="default", metavar="NAME",
                           help="which [benchmark.NAME.<imager>] in defaults.toml "
                                "to run (default: %(default)s)")
    bench_run.add_argument("--repeat", type=int, default=1, metavar="N",
                           help="run it N times, which is how the error bar on "
                                "this commit gets smaller (default: %(default)s)")
    bench_run.set_defaults(handler=do_bench_run)

    bench_record = bench_subs.add_parser(
        "record", parents=[dry_run], help="add a row for a run that already finished",
        description="Every search does this itself when it finishes; this is for "
                    "one that finished before it did, and it stamps the commit "
                    "checked out now rather than the one that ran.",
    )
    bench_record.add_argument("run", metavar="RUN",
                              help="run directory, or its name under results/nested-sampling/")
    bench_record.set_defaults(handler=do_bench_record)

    merge = add("merge", do_merge, "merge compatible runs into one",
                description="Post-processing only. Sources must agree on imager, "
                            "VLA config, metric and parameter space; sampler effort "
                            "may differ. With no arguments, auto-groups every "
                            "completed run.")
    merge.add_argument("runs", nargs="*", metavar="RUN", help="run directories to merge")
    merge.add_argument("--out", metavar="DIR",
                       help="output directory (only with an explicit run list)")

    plot = add("plot", None, "render figures and open the sample viewer")
    plot_subs = plot.add_subparsers(dest="plot_command", metavar="<what>", required=True)

    plot_fits = plot_subs.add_parser(
        "fits", parents=[dry_run], help="render FITS images to PNG in results/",
        description="Render FITS to PNG using the r2d2 image's astropy and "
                    "matplotlib, so no host Python environment is needed. With no "
                    "arguments, renders whichever standard smoke-test output exists.",
    )
    plot_fits.add_argument("files", nargs="*", metavar="FITS",
                           help="paths in the repo, or absolute paths inside the image")
    plot_fits.set_defaults(handler=do_plot_fits)

    plot_likelihood = plot_subs.add_parser(
        "likelihood", parents=[dry_run], help="R2D2 vs WSClean failure-score figures into reports/",
        description="Plot the newest comparable merged R2D2 and WSClean runs against "
                    "each other, into reports/ where latex/notes.tex includes them from.",
    )
    plot_likelihood.set_defaults(handler=do_plot_likelihood)

    plot_gui = plot_subs.add_parser(
        "gui", parents=[dry_run], help="interactive corner plots of a run (needs a display)",
        description="Open the run's samples in anesthetic's GUI. Host-side and needs "
                    "a display, so not inside Docker or Colima.",
    )
    plot_gui.add_argument("run", nargs="?", metavar="RUN",
                          help="run directory, chains/, or PolyChord file root "
                               "(default: the newest completed run)")
    plot_gui.set_defaults(handler=do_plot_gui)

    # Everything else
    fetch = add("fetch-checkpoints", do_fetch_checkpoints,
                "fetch the pretrained R2D2 checkpoints",
                description="Cannot be fully automated: the host is behind a "
                            "Cloudflare challenge. The script tries, and otherwise "
                            "prints the URL and where to put the file.")
    fetch.add_argument("realisation", nargs="?", default="R2D2_A1_T2_Realisation1.zip",
                       help="checkpoint archive (default: %(default)s)")

    record = add("record", do_record, "write an environment manifest for a run",
                 description="Write reports/manifests/<run>.json: repo revision, image "
                             "digest, host and the exact command. It records only - it "
                             "does not run the command, so run the pipeline yourself "
                             "and pass the same command verbatim after --. The search "
                             "commands call this themselves.")
    record.add_argument("--tool", required=True,
                        choices=("wsclean", "r2d2", "meqtrees", "polychord"))
    record.add_argument("--image", required=True, metavar="IMAGE[:TAG]")
    record.add_argument("--config", metavar="PATH", help="config file to hash and record")
    record.add_argument("command", nargs=argparse.REMAINDER, metavar="-- COMMAND",
                        help="the exact command that was run, recorded verbatim")

    add("clean", do_clean, "remove this repo's images and smoke-test output",
        description="Removes the images built here and the generated smoke-test "
                    "output. Your data/, checkpoints/, results/ and reports/ are left "
                    "alone. Run 'docker builder prune' to reclaim build cache.")
    add("disk-usage", do_disk_usage, "what Docker is using on disk")

    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    # argparse.REMAINDER keeps the `--` separator; record-environment.sh adds
    # its own, so drop it here.
    if args.handler is do_record and args.command[:1] == ["--"]:
        args.command = args.command[1:]

    env, commands = args.handler(args)

    if args.dry_run:
        # Quoted so a printed line can be pasted into a shell as it stands.
        prefix = "".join(f"{k}={shlex.quote(v)} " for k, v in sorted(env.items()))
        for command in commands:
            print(prefix + shlex.join(command))
        return 0

    child_env = {**os.environ, **env}
    for command in commands:
        try:
            result = subprocess.run(command, cwd=REPO_ROOT, env=child_env, check=False)
        except FileNotFoundError:
            print(f"ERROR: {command[0]} is not installed or not on PATH",
                  file=sys.stderr)
            return 127
        if result.returncode != 0:
            return result.returncode
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        # Ctrl-C is the documented way to stop `./ri serve`, and the ordinary
        # way to abandon a long `./ri search`. subprocess.run re-raises it out
        # of its own waitpid, so without this every one of those ends in a
        # traceback. 130 is the shell's convention for SIGINT.
        sys.exit(130)
