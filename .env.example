# Copy to .env and adjust for your machine. `compose.yaml` reads these.
# This file controls runtime/mount configuration only - upstream software
# revisions are pinned in versions.env, not here.

# Host directories bind-mounted into the containers. Absolute or relative
# to this file's directory both work; relative paths are resolved by
# Docker Compose relative to the project root.
DATA_DIR=./data
CHECKPOINTS_DIR=./checkpoints
RESULTS_DIR=./results

# Host UID/GID to run as inside the containers, so files written into
# bind mounts are owned by you rather than root. Run `id -u` / `id -g`.
HOST_UID=501
HOST_GID=20

# Threads made available to WSClean (-j) and BLAS/OpenMP libraries.
# Leave unset to let each tool auto-detect; set explicitly to keep
# nested-sampling evaluations comparable across runs.
WSCLEAN_THREADS=
OMP_NUM_THREADS=
R2D2_OMP_THREADS=

# Docker platform. Normally leave this unset: scripts/lib/defaults.sh derives
# it from the host architecture, and Docker itself defaults to the host for
# compose.yaml. Set it only to deliberately cross-build for the other
# architecture, which runs under the slow QEMU emulation the README's "Apple
# Silicon limitations" warns about.
#
# Note that this file is read by Docker Compose only. `make` and scripts/*.sh
# read the process environment, so `export DOCKER_DEFAULT_PLATFORM=...` in
# your shell is what overrides those.
#DOCKER_DEFAULT_PLATFORM=linux/amd64

# Host path of the Docker socket, bind-mounted into the PolyChord container
# so it can launch per-evaluation sidecars. Leave empty: the run scripts
# derive it from DOCKER_HOST, which is what makes rootless Docker
# (unix:///run/user/$(id -u)/docker.sock) work without extra wiring.
DOCKER_SOCKET=
