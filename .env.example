# Copy to .env and adjust for your machine. `compose.yaml` reads these.
# This file controls runtime/mount configuration only - upstream software
# revisions are pinned in versions.env, not here.

# Host directories bind-mounted into the containers. Absolute or relative
# to this file's directory both work; relative paths are resolved by
# Docker Compose relative to the project root.
DATA_DIR=./data
CHECKPOINTS_DIR=./checkpoints
RESULTS_DIR=./results
BENCHMARKS_DIR=./benchmarks

# Host UID/GID to run as inside the containers, so files written into
# bind mounts are owned by you rather than root. Run `id -u` / `id -g`.
HOST_UID=501
HOST_GID=20

# Threads made available to WSClean (-j) and BLAS/OpenMP libraries.
# Leave unset to let each tool auto-detect; set explicitly for
# reproducible benchmark runs.
WSCLEAN_THREADS=
OMP_NUM_THREADS=
R2D2_OMP_THREADS=

# Docker platform. Apple Silicon hosts should leave this as linux/arm64.
# Set to linux/amd64 only when explicitly testing emulation or building
# on/for an x86_64 host - see README "Apple Silicon limitations".
DOCKER_DEFAULT_PLATFORM=linux/arm64
