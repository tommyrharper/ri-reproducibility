# Pinned upstream revisions for this reproducibility environment.
#
# This file is the single source of truth for every immutable upstream
# reference used by the Docker builds. Do not replace any commit hash here
# with a floating branch name. Update this file deliberately, commit the
# change, and rebuild both images when a new upstream revision is adopted.
#
# How each pin was selected is recorded in README.md ("How upstream
# revisions are pinned").
#
# NOTE: this file is documentation/record-keeping, not consumed
# automatically by `docker build` (which cannot read .env files as
# build-arg defaults). Each Dockerfile's `ARG ..._GIT_TAG=...` /
# `ARG ..._GIT_COMMIT=...` defaults must currently be kept in sync with
# this file BY HAND when a pin changes - update both together.

# --- WSClean -----------------------------------------------------------
# https://gitlab.com/aroffringa/wsclean
# Tag v3.7, released 2026-02-14. Latest stable tagged release at the time
# this environment was built (master branch intentionally not used, per
# upstream's own installation guidance).
WSCLEAN_GIT_URL=https://gitlab.com/aroffringa/wsclean.git
WSCLEAN_GIT_TAG=v3.7
WSCLEAN_GIT_COMMIT=4f395b28abb5eb0ceacfa05f61e3ee49d154d001
# Submodule pins resolved by the tag above (recorded for documentation only;
# `git clone --recurse-submodules --branch v3.7` resolves these automatically).
WSCLEAN_SUBMODULE_AOCOMMON=aa4d6a47b864b76d8cec372c02423e1e9398bfac
WSCLEAN_SUBMODULE_RADLER=76fe4474c31ca2e2269a9ddfd18e21a9adaeb06a
WSCLEAN_SUBMODULE_SCHAAPCOMMON=b553fd254c55f33b26a7d2b046adf568524c1729

# casacore is a required WSClean dependency built from source because
# Debian's packaged casacore-dev on bookworm is older than the >=3.6
# minimum WSClean v3.7 requires.
# https://github.com/casacore/casacore
CASACORE_GIT_URL=https://github.com/casacore/casacore.git
CASACORE_GIT_TAG=v3.8.1
CASACORE_GIT_COMMIT=5420b48e8acac24e70931a0f1646a6f247c07544

# casacore "measures" data (IERS/leap-second/ephemeris tables) is
# continuously updated upstream and has no versioned release - see the
# "Reproducibility limitations" section of README.md.
CASACORE_MEASURES_URL=ftp://ftp.astron.nl/outgoing/Measures/WSRT_Measures.ztar

# --- R2D2-RI -------------------------------------------------------------
# https://github.com/basp-group/R2D2-RI (main branch = v2.0, no git tags
# exist upstream at the time of writing; the commit below is main HEAD as
# inspected on 2026-08-03).
R2D2_GIT_URL=https://github.com/basp-group/R2D2-RI.git
R2D2_GIT_COMMIT=22669259f770a0cb3a3191a5d3e8dbad4ae5a70c

# Required submodule (declared in R2D2-RI's .gitmodules, branch "python").
# https://github.com/basp-group/RI-measurement-operator
R2D2_SUBMODULE_URL=https://github.com/basp-group/RI-measurement-operator.git
R2D2_SUBMODULE_BRANCH=python
R2D2_SUBMODULE_COMMIT=3c8a93e9127ccaf115d1e3772fbee74aaaccf8e8

R2D2_PYTHON_VERSION=3.10

# Pretrained checkpoint series (VLA-trained R2D2 U-Net / U-WDSR).
# DOI: https://doi.org/10.17861/e3060b95-4fe6-4b61-9f72-d77653c305bb
R2D2_CHECKPOINT_DOI=10.17861/e3060b95-4fe6-4b61-9f72-d77653c305bb
