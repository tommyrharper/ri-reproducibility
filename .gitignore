# Datasets, checkpoints, and generated outputs are bind-mounted at runtime
# and must never be committed.
data/*
!data/README.md
checkpoints/*
!checkpoints/README.md
results/*
!results/.gitkeep
reports/manifests/*
!reports/manifests/.gitkeep
reports/nested-sampling-report/
reports/merged-r2d2-wsclean-*.png
core
vendor/*
!vendor/README.md

# Environment / secrets
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.mypy_cache/
.pytest_cache/
.ipynb_checkpoints/

# CMake / C++ build artefacts (only relevant if building outside Docker)
build/
CMakeCache.txt
CMakeFiles/
*.o
*.so

# Editors
.vscode/
.idea/
*.swp

# macOS
.DS_Store

# Profiling artefacts
*.prof
*.trace

# latex
latex/*.aux
latex/*.log
latex/*.synctex.gz
latex/*.synctex(busy)
latex/*.pdf
latex/*.out
latex/*.fdb_latexmk
latex/*.fls
latex/*.log
latex/*.bbl
latex/*.blg
latex/*.toc

# agents
.claude

# Go TUI build artefacts
tui/.build/
