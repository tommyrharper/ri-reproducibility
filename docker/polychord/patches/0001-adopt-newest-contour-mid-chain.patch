diff --git a/src/polychord/mpi_utils.F90 b/src/polychord/mpi_utils.F90
index 0c587bb..ca62724 100644
--- a/src/polychord/mpi_utils.F90
+++ b/src/polychord/mpi_utils.F90
@@ -21,6 +21,18 @@ module mpi_module
     integer, parameter :: tag_run_epoch_seed=9
     integer, parameter :: tag_run_epoch_babies=10
     integer, parameter :: tag_run_stop=11
+    integer, parameter :: tag_run_contour=12
+
+    ! Contour adoption (PC_ADOPT_CONTOUR=1, asynchronous MPI only): the
+    ! administrator sends each worker its cluster's newest contour after every
+    ! replacement, and a worker raises its slice contour to it between slice
+    ! steps when its current point is already above it, so fewer chains return
+    ! below the contour and are thrown away.
+    logical :: adopt_contour = .false.
+    integer :: contour_comm = 0
+    integer :: contour_root = 0
+    integer, allocatable, dimension(:) :: contour_requests
+    real(dp), allocatable, dimension(:) :: contour_buffers
 
     type mpi_bundle
         integer :: rank
@@ -35,6 +47,27 @@ module mpi_module
 
     contains
 
+    !> Worker: take the newest contour the administrator has sent, if any
+    function poll_contour(logL) result(got)
+        implicit none
+        real(dp), intent(inout) :: logL
+        logical :: got
+#ifdef MPI
+        logical :: flag
+        integer, dimension(MPI_STATUS_SIZE) :: mpistatus
+#endif
+        got = .false.
+#ifdef MPI
+        if(.not. adopt_contour) return
+        do
+            call MPI_IPROBE(contour_root,tag_run_contour,contour_comm,flag,mpistatus,mpierror)
+            if(.not. flag) exit
+            call MPI_RECV(logL,1,MPI_DOUBLE_PRECISION,contour_root,tag_run_contour,contour_comm,mpistatus,mpierror)
+            got = .true.
+        end do
+#endif
+    end function poll_contour
+
     !> Subroutine to get all mpi information
     function get_mpi_information(mpi_communicator,colour) result(mpi_information)
         implicit none
@@ -484,6 +517,7 @@ module mpi_module
         integer, dimension(MPI_STATUS_SIZE) :: mpistatus ! status identifier
 
 
+        do
         call MPI_RECV(                   &!
             seed_point,                  &!
             size(seed_point),            &!
@@ -494,6 +528,8 @@ module mpi_module
             mpistatus,                   &!
             mpierror                     &!
             )
+        if(mpistatus(MPI_TAG) /= tag_run_contour) exit
+        end do
         if(mpistatus(MPI_TAG) == tag_run_stop ) then
             more_points_needed = .false.
             return
@@ -698,6 +734,53 @@ module mpi_module
 
     end function live_point_needed
 
+    !> Administrator: start adopting contours (PC_ADOPT_CONTOUR=1, asynchronous only)
+    subroutine init_contours(mpi_information,synchronous)
+        implicit none
+        type(mpi_bundle), intent(in) :: mpi_information
+        logical, intent(in) :: synchronous
+        character(len=8) :: env
+        integer :: length, status
+        call get_environment_variable('PC_ADOPT_CONTOUR',env,length,status)
+        adopt_contour = status==0 .and. env(1:1)=='1' .and. .not. synchronous .and. mpi_information%nprocs>1
+        contour_comm = mpi_information%communicator
+        contour_root = mpi_information%root
+        if(adopt_contour .and. is_root(mpi_information)) then
+            allocate(contour_requests(mpi_information%nprocs-1),contour_buffers(mpi_information%nprocs-1))
+            contour_requests = MPI_REQUEST_NULL
+        end if
+    end subroutine init_contours
+
+    !> Administrator: send worker i the contour logLs(i), skipping a worker whose last one is still in flight
+    subroutine throw_contours(logLs)
+        implicit none
+        real(dp), intent(in), dimension(:) :: logLs
+        integer :: worker_id
+        logical :: done
+        integer, dimension(MPI_STATUS_SIZE) :: mpistatus
+        if(.not. adopt_contour) return
+        do worker_id=1,size(logLs)
+            if(contour_requests(worker_id) /= MPI_REQUEST_NULL) then
+                call MPI_TEST(contour_requests(worker_id),done,mpistatus,mpierror)
+                if(.not. done) cycle
+            end if
+            contour_buffers(worker_id) = logLs(worker_id)
+            call MPI_ISEND(contour_buffers(worker_id),1,MPI_DOUBLE_PRECISION,worker_id,tag_run_contour, &
+                contour_comm,contour_requests(worker_id),mpierror)
+        end do
+    end subroutine throw_contours
+
+    !> Administrator: complete every contour send (workers drain them before their stop signal)
+    subroutine finish_contours()
+        implicit none
+        integer, allocatable, dimension(:,:) :: mpistatuses
+        if(.not. allocated(contour_requests)) return
+        allocate(mpistatuses(MPI_STATUS_SIZE,size(contour_requests)))
+        call MPI_WAITALL(size(contour_requests),contour_requests,mpistatuses,mpierror)
+        deallocate(contour_requests,contour_buffers)
+        adopt_contour = .false.
+    end subroutine finish_contours
+
 
 #endif
 
