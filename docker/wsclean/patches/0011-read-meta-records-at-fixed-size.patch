+
+// A whole record is the common case: copy it at its compile-time size, so the
+// copy is two vector moves rather than a variable-length loop whose narrow
+// stores the caller's wide reload of the record then stalls on.
+template <typename Record>
+bool ReadMappedRecord(const MappedFile& file, size_t size, size_t& pos,
+                      Record* dest) {
+  if (pos < size && size - pos >= sizeof(Record)) {
+    std::memcpy(dest, file.Data() + pos, sizeof(Record));
+    pos += sizeof(Record);
+    return true;
+  }
+  return ReadMapped(file, size, pos, dest, sizeof(Record));
+}
