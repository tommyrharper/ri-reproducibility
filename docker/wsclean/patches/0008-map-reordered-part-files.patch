 namespace wsclean {
 
+namespace {
+// What istream::read did at the end of a file: copy what is there, stop at
+// the end, and report whether the whole record was read.
+bool ReadMapped(const MappedFile& file, size_t size, size_t& pos, void* dest,
+                size_t n) {
+  const size_t available = pos < size ? size - pos : 0;
+  const size_t count = n < available ? n : available;
+  if (count) std::memcpy(dest, file.Data() + pos, count);
+  pos += count;
+  return count == n;
+}
+}  // namespace
