+casacore::MeasurementSet OpenMeasurementSet(const std::string& path) {
+  static std::mutex mutex;
+  // Deliberately never destroyed: casacore's own table cache is a static too,
+  // and if it is torn down first the measurement sets left here close against
+  // freed state and the process dies in its exit handlers, after the images
+  // have already been written.
+  static std::map<std::string, casacore::MeasurementSet>& cache =
+      *new std::map<std::string, casacore::MeasurementSet>();
+  const std::lock_guard<std::mutex> lock(mutex);
+  const auto [iterator, inserted] = cache.try_emplace(path);
+  if (inserted) iterator->second = casacore::MeasurementSet(path);
+  return iterator->second;
+}
