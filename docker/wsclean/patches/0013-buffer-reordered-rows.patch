+namespace {
+// A file's buffered rows are written once they reach this size.
+constexpr size_t kFlushBytes = 1 << 20;
+
+template <typename T>
+T* Grow(std::vector<T>& buffer, size_t n) {
+  if (buffer.capacity() == 0) buffer.reserve(kFlushBytes / sizeof(T) + n);
+  const size_t old_size = buffer.size();
+  buffer.resize(old_size + n);
+  return buffer.data() + old_size;
+}
+
+template <typename T>
+void Write(std::vector<T>& buffer, std::ostream& stream, const char* error) {
+  if (buffer.empty()) return;
+  stream.write(reinterpret_cast<const char*>(buffer.data()),
+               buffer.size() * sizeof(T));
+  if (!stream.good()) throw std::runtime_error(error);
+  buffer.clear();
+}
+
+template <typename T>
+void WriteIfFull(std::vector<T>& buffer, std::ostream& stream,
+                 const char* error) {
+  if (buffer.size() * sizeof(T) >= kFlushBytes) Write(buffer, stream, error);
+}
+
+template <typename Buffer>
+void Append(std::vector<char>& pending, const Buffer& record) {
+  std::memcpy(Grow(pending, sizeof(Buffer)), &record, sizeof(Buffer));
+}
