+void FileWriter::FlushPending() {
+  for (ReorderedDataFiles& f : files_) {
+    Write(f.pending_data, *f.data, "Error writing to temporary data file");
+    if (f.model) {
+      Write(f.pending_model, *f.model,
+            "Error writing to temporary model data file");
+    }
+    Write(f.pending_weight, *f.weight,
+          "Error writing to temporary weights file");
+  }
+  for (MetaFileData& file_data : meta_files_) {
+    Write(file_data.pending, file_data.file, "Error writing to temporary file");
+  }
+}
