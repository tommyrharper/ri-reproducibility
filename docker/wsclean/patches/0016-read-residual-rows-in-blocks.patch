+size_t ReorderedMsReader::MapDataAndModelRows(
+    size_t max_rows, size_t n_values, const std::complex<float>*& data,
+    const std::complex<float>*& model) {
+  ReorderedMsProvider& reordered_ms =
+      static_cast<ReorderedMsProvider&>(*ms_provider_);
+  // In a regular set every row has the same width, so the rows' data are
+  // consecutive in the data file and their models in the model file.
+  if (!Provider().IsRegular() || has_data_ ||
+      !reordered_ms.part_header_.has_model ||
+      NVisibilitiesPerRow(metadata_.data_desc_id) != n_values)
+    return 0;
+  const size_t available =
+      reordered_ms.meta_header_.selected_row_count - current_input_row_;
+  const size_t n_rows = std::min(max_rows, available);
+  const size_t n_bytes = n_rows * n_values * sizeof(std::complex<float>);
+  if (n_rows == 0 || data_pos_ > data_size_ || data_size_ - data_pos_ < n_bytes)
+    return 0;
+  data = reinterpret_cast<const std::complex<float>*>(data_file_.Data() +
+                                                      data_pos_);
+  model = reinterpret_cast<const std::complex<float>*>(
+              reordered_ms.model_file_.Data()) +
+          current_value_position_;
+  data_pos_ += n_bytes;
+  current_value_position_ += n_rows * n_values;
+  current_input_row_ += n_rows;
+  has_weights_ = false;
+  // The current row's meta record has been read; skip the others and read
+  // the next row's, as NextInputRow() would have.
+  meta_pos_ += (n_rows - 1) *
+               sizeof(schaapcommon::reordering::details::MetaRecordBuffer);
+  CacheMeta();
+  return n_rows;
+}
