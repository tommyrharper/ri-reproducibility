+/** Copy row @p index out of a block of rows read by fillBlock(). */
+template <typename T>
+void CopyRowFromBlock(const casacore::Array<T>& block, size_t index,
+                      casacore::Array<T>& row,
+                      const casacore::IPosition& shape, size_t n) {
+  if (!row.shape().isEqual(shape)) row.resize(shape);
+  std::copy_n(block.data() + n * index, n, row.data());
+}
+
+/**
+ * Number of rows to read per block. Large enough that casacore's per-call
+ * overhead stops mattering, small enough that a wide set does not turn one
+ * block into hundreds of megabytes.
+ */
+size_t BlockRowCount(size_t row_elements) {
+  constexpr size_t kMaxBlockValues = 4 * 1024 * 1024;
+  constexpr size_t kMaxBlockRows = 1024;
+  return std::clamp<size_t>(kMaxBlockValues / std::max<size_t>(row_elements, 1),
+                            1, kMaxBlockRows);
+}
