+size_t MSRowProvider::EndTimestep() {
+  // Only baseline-dependent averaging asks for this, and answering it means
+  // walking the whole TIME column, so it is not computed until it is wanted.
+  if (!_endTimestep) {
+    const casacore::Vector<double> times = Columns().time.getColumnRange(
+        casacore::Slicer(casacore::IPosition(1, BeginRow()),
+                         casacore::IPosition(1, EndRow() - BeginRow())));
+    size_t timestep = _startTimestep;
+    double time = times[0];
+    for (double t : times) {
+      if (time != t) {
+        ++timestep;
+        time = t;
+      }
+    }
+    _endTimestep = timestep;
+  }
+  return *_endTimestep;
+}
+
+void MSRowProvider::fillBlock(size_t row) {
+  MsColumns& columns = Columns();
+  size_t rows = std::min(_blockRows, EndRow() - row);
+  const casacore::Slicer range(casacore::IPosition(1, row),
+                               casacore::IPosition(1, rows));
+  if (rows > 1) {
+    try {
+      columns.time.getColumnRange(range, _blockTime, true);
+      columns.antenna_1.getColumnRange(range, _blockAntenna1, true);
+      columns.antenna_2.getColumnRange(range, _blockAntenna2, true);
+      columns.field_id.getColumnRange(range, _blockFieldId, true);
+      columns.data_description_id.getColumnRange(range, _blockDataDescId, true);
+      columns.uvw.getColumnRange(range, _blockUvw, true);
+    } catch (const std::exception&) {
+      // Rows of differing shape; fall back to upstream's one row at a time.
+      _blockRows = 1;
+      rows = 1;
+    }
+  }
+  if (rows == 1) {
+    const casacore::Slicer one(casacore::IPosition(1, row),
+                               casacore::IPosition(1, 1));
+    columns.time.getColumnRange(one, _blockTime, true);
+    columns.antenna_1.getColumnRange(one, _blockAntenna1, true);
+    columns.antenna_2.getColumnRange(one, _blockAntenna2, true);
+    columns.field_id.getColumnRange(one, _blockFieldId, true);
+    columns.data_description_id.getColumnRange(one, _blockDataDescId, true);
+    columns.uvw.getColumnRange(one, _blockUvw, true);
+  }
+  _blockUvwShape = _blockUvw.shape().getFirst(_blockUvw.ndim() - 1);
+  _blockUvwElements = _blockUvwShape.product();
+  _blockBegin = row;
+  _blockEnd = row + rows;
+  _blockHasVisibilities = false;
+}
+
+void MSRowProvider::fillBlockVisibilities(size_t row, size_t rows) {
+  MsColumns& columns = Columns();
+  const casacore::Slicer range(casacore::IPosition(1, row),
+                               casacore::IPosition(1, rows));
+  columns.data.getColumnRange(range, _blockData, true);
+  columns.flag.getColumnRange(range, _blockFlag, true);
+  if (_msHasWeights)
+    _weightSpectrumColumn->getColumnRange(range, _blockWeights, true);
+  else
+    _weightScalarColumn->getColumnRange(range, _blockWeights, true);
+  _blockDataShape = _blockData.shape().getFirst(_blockData.ndim() - 1);
+  _blockDataElements = _blockDataShape.product();
+  _blockFlagShape = _blockFlag.shape().getFirst(_blockFlag.ndim() - 1);
+  _blockFlagElements = _blockFlagShape.product();
+  _blockWeightsShape = _blockWeights.shape().getFirst(_blockWeights.ndim() - 1);
+  _blockWeightsElements = _blockWeightsShape.product();
+  _blockHasVisibilities = true;
+}
+
+void MSRowProvider::getCurrentData(DataArray& data) {
+  ensureBlock(_currentRow);
+  if (!_blockHasVisibilities)
+    fillBlockVisibilities(_blockBegin, _blockEnd - _blockBegin);
+  CopyRowFromBlock(_blockData, _currentRow - _blockBegin, data,
+                   _blockDataShape, _blockDataElements);
+}
+
+void MSRowProvider::getCurrentFlags(FlagArray& flags) {
+  ensureBlock(_currentRow);
+  if (!_blockHasVisibilities)
+    fillBlockVisibilities(_blockBegin, _blockEnd - _blockBegin);
+  CopyRowFromBlock(_blockFlag, _currentRow - _blockBegin, flags,
+                   _blockFlagShape, _blockFlagElements);
 }
 
